+import json
+
+import httpx
+import pytest
+
+from app.webhooks import signing
+from app.webhooks.delivery import MAX_ATTEMPTS, backoff_for, send_once
+
+SECRET = "whsec_testsecret"
+
+
+class FakeEndpoint:
+    url = "https://hooks.example.com/acme"
+    signing_secret = SECRET
+
+
+class FakeDelivery:
+    id = 1
+    attempts = 0
+    payload = {"id": "evt_1", "type": "invoice.paid", "amount_cents": 4200}
+
+
+def test_new_signing_secret_has_prefix_and_length():
+    secret = signing.new_signing_secret()
+    assert secret.startswith(signing.SECRET_PREFIX)
+    assert len(secret) == len(signing.SECRET_PREFIX) + signing.SECRET_BYTES
+
+
+def test_sign_returns_timestamp_and_prefixed_digest():
+    timestamp, signature = signing.sign(SECRET, {"a": 1})
+    assert timestamp.isdigit()
+    assert signature.startswith("sha256=")
+    assert len(signature) == len("sha256=") + 64
+
+
+def test_verify_accepts_signature_produced_by_sign():
+    payload = {"b": 2, "a": 1}
+    _, signature = signing.sign(SECRET, payload)
+    assert signing.verify(SECRET, payload, signature)
+
+
+def test_verify_rejects_a_signature_made_with_another_secret():
+    payload = {"a": 1}
+    _, signature = signing.sign("whsec_someoneelse", payload)
+    assert not signing.verify(SECRET, payload, signature)
+
+
+@pytest.mark.parametrize("attempt,seconds", [(1, 2), (2, 4), (3, 8), (4, 16)])
+def test_backoff_grows_exponentially(attempt, seconds):
+    assert backoff_for(attempt).total_seconds() == seconds
+
+
+def test_max_attempts_matches_documented_limit():
+    assert MAX_ATTEMPTS == 5
+
+
+@pytest.mark.asyncio
+async def test_send_once_posts_the_signed_payload():
+    captured = {}
+
+    def handler(request: httpx.Request) -> httpx.Response:
+        captured["headers"] = request.headers
+        captured["body"] = request.content
+        return httpx.Response(200, text="ok")
+
+    async with httpx.AsyncClient(transport=httpx.MockTransport(handler)) as client:
+        response = await send_once(client, FakeEndpoint(), FakeDelivery())
+
+    assert response.status_code == 200
+    assert captured["headers"][signing.SIGNATURE_HEADER].startswith("sha256=")
+    assert captured["headers"][signing.TIMESTAMP_HEADER].isdigit()
+    assert captured["headers"]["content-type"] == "application/json"
+    assert json.loads(captured["body"])["type"] == "invoice.paid"
+
+
+@pytest.mark.asyncio
+async def test_send_once_propagates_connection_errors():
+    def handler(request: httpx.Request) -> httpx.Response:
+        raise httpx.ConnectError("boom", request=request)
+
+    async with httpx.AsyncClient(transport=httpx.MockTransport(handler)) as client:
+        with pytest.raises(httpx.ConnectError):
+            await send_once(client, FakeEndpoint(), FakeDelivery())
