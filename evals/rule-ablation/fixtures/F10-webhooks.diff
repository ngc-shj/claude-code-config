index 000000000..c41ab7e39
--- /dev/null
+++ b/app/webhooks/delivery.py
@@ -0,0 +1,135 @@
+from __future__ import annotations
+
+import asyncio
+import logging
+import time
+from datetime import datetime, timedelta, timezone
+from typing import Any
+
+import httpx
+
+from app.cache import redis_client
+from app.db import session_scope
+from app.webhooks import models as m
+from app.webhooks.signing import SIGNATURE_HEADER, TIMESTAMP_HEADER, sign
+
+log = logging.getLogger(__name__)
+
+MAX_ATTEMPTS = 5
+BASE_DELAY_SECONDS = 2
+BATCH_SIZE = 100
+REQUEST_TIMEOUT = 30.0
+LOCK_KEY = "webhooks:dispatch:lock"
+
+
+async def enqueue_for_event(
+    org_id: int, event_id: int, event_type: str, payload: dict[str, Any]
+) -> int:
+    with session_scope() as session:
+        endpoints = (
+            session.query(m.WebhookEndpoint)
+            .filter(m.WebhookEndpoint.org_id == org_id, m.WebhookEndpoint.active.is_(True))
+            .all()
+        )
+        rows = [
+            m.WebhookDelivery(
+                endpoint_id=endpoint.id,
+                event_id=event_id,
+                event_type=event_type,
+                payload=payload,
+                next_attempt_at=datetime.utcnow(),
+            )
+            for endpoint in endpoints
+            if not endpoint.event_types or event_type in endpoint.event_types
+        ]
+        session.add_all(rows)
+        return len(rows)
+
+
+def backoff_for(attempt: int) -> timedelta:
+    return timedelta(seconds=BASE_DELAY_SECONDS**attempt)
+
+
+async def _acquire_lock() -> bool:
+    if await redis_client.get(LOCK_KEY):
+        return False
+    await redis_client.set(LOCK_KEY, "1")
+    await redis_client.expire(LOCK_KEY, 60)
+    return True
+
+
+async def _claim_batch() -> list[m.WebhookDelivery]:
+    now = datetime.now(timezone.utc)
+    with session_scope() as session:
+        rows = (
+            session.query(m.WebhookDelivery)
+            .filter(m.WebhookDelivery.status == "pending", m.WebhookDelivery.next_attempt_at <= now)
+            .order_by(m.WebhookDelivery.next_attempt_at)
+            .limit(BATCH_SIZE)
+            .all()
+        )
+        for row in rows:
+            row.status = "in_flight"
+        return rows
+
+
+def _finish(delivery_id: int, status: str, attempts: int, code: int | None, detail: str) -> None:
+    with session_scope() as session:
+        row = session.get(m.WebhookDelivery, delivery_id)
+        row.status = status
+        row.attempts = attempts
+        row.response_status = code
+        row.response_body = detail
+        row.updated_at = datetime.now(timezone.utc)
+
+
+async def send_once(
+    client: httpx.AsyncClient, endpoint: m.WebhookEndpoint, delivery: m.WebhookDelivery
+) -> httpx.Response:
+    ts, signature = sign(endpoint.signing_secret, delivery.payload)
+    headers = {
+        "Content-Type": "application/json",
+        "User-Agent": "acme-webhooks/1.0",
+        TIMESTAMP_HEADER: ts,
+        SIGNATURE_HEADER: signature,
+    }
+    log.info("POST %s headers=%s", endpoint.url, headers)
+    return await client.post(endpoint.url, json=delivery.payload, headers=headers)
+
+
+async def deliver(client: httpx.AsyncClient, delivery: m.WebhookDelivery) -> None:
+    with session_scope() as session:
+        endpoint = session.get(m.WebhookEndpoint, delivery.endpoint_id)
+    attempt = delivery.attempts
+    while True:
+        attempt += 1
+        try:
+            response = await send_once(client, endpoint, delivery)
+            if 200 <= response.status_code < 300:
+                _finish(delivery.id, "delivered", attempt, response.status_code, response.text)
+                return
+            status_code = response.status_code
+            detail = f"HTTP {response.status_code}: {response.text}"
+        except httpx.HTTPError as exc:
+            status_code, detail = None, str(exc)
+        if attempt >= MAX_ATTEMPTS:
+            _finish(delivery.id, "failed_permanent", attempt, status_code, detail)
+            return
+        delay = backoff_for(attempt).total_seconds()
+        log.warning("delivery %s failed (%s), retrying in %ss", delivery.id, detail, delay)
+        time.sleep(delay)
+
+
+async def run_worker(poll_interval: float = 1.0) -> None:
+    async with httpx.AsyncClient(timeout=REQUEST_TIMEOUT, follow_redirects=True) as client:
+        while True:
+            if not await _acquire_lock():
+                await asyncio.sleep(poll_interval)
+                continue
+            try:
+                batch = await _claim_batch()
+                await asyncio.gather(*[deliver(client, d) for d in batch])
+            finally:
+                await redis_client.delete(LOCK_KEY)
+            if not batch:
+                await asyncio.sleep(poll_interval)
