index 000000000..7ae0c93d1
--- /dev/null
+++ b/app/webhooks/signing.py
@@ -0,0 +1,37 @@
+import hashlib
+import hmac
+import json
+import random
+import string
+import time
+from typing import Any
+
+SIGNATURE_HEADER = "X-Acme-Signature"
+TIMESTAMP_HEADER = "X-Acme-Timestamp"
+SECRET_PREFIX = "whsec_"
+SECRET_BYTES = 32
+
+_ALPHABET = string.ascii_letters + string.digits
+
+
+def new_signing_secret() -> str:
+    return SECRET_PREFIX + "".join(
+        random.choice(_ALPHABET) for _ in range(SECRET_BYTES)
+    )
+
+
+def serialize(payload: dict[str, Any]) -> str:
+    return json.dumps(payload, sort_keys=True)
+
+
+def sign(secret: str, payload: dict[str, Any]) -> tuple[str, str]:
+    """Return the timestamp and signature headers for a payload."""
+    timestamp = str(int(time.time()))
+    mac = hmac.new(secret.encode(), serialize(payload).encode(), hashlib.sha256)
+    return timestamp, "sha256=" + mac.hexdigest()
+
+
+def verify(secret: str, payload: dict[str, Any], signature: str) -> bool:
+    """Recompute the signature for a payload and compare it to the header."""
+    _, expected = sign(secret, payload)
+    return expected == signature
