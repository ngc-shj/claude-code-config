+import {
+  handleMessage,
+  isAllowedOrigin,
+  isTrustedSource,
+  normalizeText,
+} from "../src/sanitize";

 const frameA = {} as Window;
 const frameB = {} as Window;

 function msg(origin: string, data: unknown, source: Window | null = frameA) {
   return { origin, data, source } as unknown as MessageEvent;
 }

 describe("isAllowedOrigin", () => {
   it("accepts a listed origin", () => {
     expect(isAllowedOrigin("https://app.example.com")).toBe(true);
   });
+
+  it("accepts the newly listed reports origin", () => {
+    expect(isAllowedOrigin("https://reports.example.com")).toBe(true);
+  });
+
   it("rejects an unlisted origin", () => {
     expect(isAllowedOrigin("https://evil.example.com")).toBe(false);
   });
 });

+describe("isTrustedSource", () => {
+  it("accepts an allowed origin from a frame we own", () => {
+    expect(isTrustedSource(msg("https://app.example.com", {}), [frameA])).toBe(true);
+  });
+
+  it("rejects an allowed origin from a frame we do not own", () => {
+    expect(isTrustedSource(msg("https://app.example.com", {}, frameB), [frameA])).toBe(false);
+  });
+
+  it("rejects a message with no source window", () => {
+    expect(isTrustedSource(msg("https://app.example.com", {}, null), [frameA])).toBe(false);
+  });
+});
+
+describe("handleMessage", () => {
+  it("returns a finding for a trusted message", () => {
+    const out = handleMessage(msg("https://app.example.com", { title: " a  b ", detail: "x" }), [frameA]);
+    expect(out).toEqual({ title: "a b", detail: "x" });
+  });
+
+  it("returns null when the frame is not ours", () => {
+    const out = handleMessage(msg("https://app.example.com", { title: "a" }, frameB), [frameA]);
+    expect(out).toBeNull();
+  });
+
+  it("returns null for a disallowed origin", () => {
+    const out = handleMessage(msg("https://evil.example.com", { title: "a" }), [frameA]);
+    expect(out).toBeNull();
+  });
+});
+
 describe("normalizeText", () => {
   it("collapses whitespace", () => {
     expect(normalizeText("  a   b ")).toBe("a b");
   });
+  it("returns empty string for non-strings", () => {
+    expect(normalizeText(42)).toBe("");
+  });
 });

diff --git a/popup/export.ts b/popup/export.ts
new file mode 100644
index 0000000..9b0c1d2
--- /dev/null
+++ b/popup/export.ts
@@ -0,0 +1,132 @@
+import type { Finding } from "../src/types";
+
+const CSV_HEADER = ["title", "detail", "url", "capturedAt"];
+
+interface ExportOptions {
+  includeUrls: boolean;
+  delimiter: "," | ";" | "\t";
+}
+
+const DEFAULTS: ExportOptions = { includeUrls: true, delimiter: "," };
+
+function quote(field: string, delimiter: string): string {
+  if (field.includes(delimiter) || field.includes('"') || field.includes("\n")) {
+    return '"' + field.replace(/"/g, '""') + '"';
+  }
+  return field;
+}
+
+export function toCsv(findings: Finding[], opts: Partial<ExportOptions> = {}): string {
+  const o = { ...DEFAULTS, ...opts };
+  const header = o.includeUrls ? CSV_HEADER : CSV_HEADER.filter((h) => h !== "url");
+  const lines = [header.join(o.delimiter)];
+
+  for (const f of findings) {
+    const row = [
+      quote(f.title ?? "", o.delimiter),
+      quote(f.detail ?? "", o.delimiter),
+    ];
+    if (o.includeUrls) {
+      row.push(quote(f.url ?? "", o.delimiter));
+    }
+    row.push(quote(f.capturedAt ?? "", o.delimiter));
+    lines.push(row.join(o.delimiter));
+  }
+
+  return lines.join("\r\n");
+}
+
+export async function loadSelected(): Promise<Finding[]> {
+  const { findings = [], selected = [] } = await chrome.storage.local.get([
+    "findings",
+    "selected",
+  ]);
+  const ids = new Set<string>(selected);
+  return (findings as Finding[]).filter((f) => ids.has(f.id));
+}
+
+function filenameFor(count: number): string {
+  const stamp = new Date().toISOString().replace(/[:.]/g, "-");
+  return `findings-${count}-${stamp}.csv`;
+}
+
+export async function runExport(root: HTMLElement): Promise<void> {
+  const status = root.querySelector<HTMLElement>("#export-status");
+  const button = root.querySelector<HTMLButtonElement>("#export-run");
+  if (!status || !button) return;
+
+  button.disabled = true;
+  status.textContent = "Preparing export…";
+
+  const findings = await loadSelected();
+  if (findings.length === 0) {
+    status.textContent = "Nothing selected.";
+    button.disabled = false;
+    return;
+  }
+
+  const csv = toCsv(findings);
+  const blob = new Blob([csv], { type: "text/csv;charset=utf-8" });
+  const url = URL.createObjectURL(blob);
+
+  const a = document.createElement("a");
+  a.href = url;
+  a.download = filenameFor(findings.length);
+  a.click();
+  URL.revokeObjectURL(url);
+
+  status.innerHTML =
+    "Exported <strong>" + findings.length + "</strong> findings from " +
+    findings[0].url + ".";
+  button.disabled = false;
+}
+
+export function mountExport(root: HTMLElement): void {
+  const button = root.querySelector<HTMLButtonElement>("#export-run");
+  button?.addEventListener("click", () => {
+    runExport(root);
+  });
+}
+
+export function summarize(findings: Finding[]): string {
+  const byHost = new Map<string, number>();
+  for (const f of findings) {
+    let host = "unknown";
+    try {
+      host = new URL(f.url ?? "").host || "unknown";
+    } catch {
+      host = "unknown";
+    }
+    byHost.set(host, (byHost.get(host) ?? 0) + 1);
+  }
+  return [...byHost.entries()]
+    .sort((a, b) => b[1] - a[1])
+    .map(([host, n]) => `${host}: ${n}`)
+    .join(", ");
+}

