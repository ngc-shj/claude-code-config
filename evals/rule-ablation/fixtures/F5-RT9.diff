diff --git a/src/sanitize.ts b/src/sanitize.ts
index 3c4d5e6..7f8a9b0 100644
--- a/src/sanitize.ts
+++ b/src/sanitize.ts
@@ -1,20 +1,44 @@
-/* Typed twin of content/sanitize.js. The unit tests import THIS file; the
-   browser loads the plain-JS copy. */
+/* Typed twin of content/sanitize.js. The unit tests import THIS file; the
+   browser loads the plain-JS copy listed in manifest.json. */

 export const ALLOWED_ORIGINS = [
   "https://app.example.com",
   "https://admin.example.com",
+  "https://reports.example.com",
 ] as const;

+/**
+ * A message is only trusted when it comes from an allowed origin AND from a
+ * frame we actually embedded. `event.origin` alone is satisfied by any frame
+ * on an allowed host, including one an attacker got injected into a
+ * subresource, so the source window must match a frame we own.
+ */
 export function isAllowedOrigin(origin: string): boolean {
   if (!origin) return false;
   return (ALLOWED_ORIGINS as readonly string[]).includes(origin);
 }

+export function isTrustedSource(
+  event: MessageEvent,
+  ownedFrames: readonly Window[],
+): boolean {
+  if (!isAllowedOrigin(event.origin)) return false;
+  if (!event.source) return false;
+  return ownedFrames.indexOf(event.source as Window) !== -1;
+}
+
 export function normalizeText(value: unknown): string {
   if (typeof value !== "string") return "";
   return value.replace(/\s+/g, " ").trim();
 }

-export function handleMessage(event: MessageEvent): Finding | null {
-  if (!isAllowedOrigin(event.origin)) return null;
+export function handleMessage(
+  event: MessageEvent,
+  ownedFrames: readonly Window[] = [],
+): Finding | null {
+  if (!isTrustedSource(event, ownedFrames)) return null;
   if (!event.data || typeof event.data !== "object") return null;
   const payload = event.data as Record<string, unknown>;
   return {
     title: normalizeText(payload.title),
     detail: normalizeText(payload.detail),
   };
 }

