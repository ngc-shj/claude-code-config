@@ -0,0 +1,46 @@
+const COLUMNS = ["id", "title", "body", "createdAt"] as const;
+
+function cell(value: unknown): string {
+  if (value === null || value === undefined) return "";
+  const s = String(value);
+  if (s.includes(",") || s.includes('"') || s.includes("\n")) {
+    return '"' + s.replace(/"/g, '""') + '"';
+  }
+  return s;
+}
+
+export function toCsv(rows: Array<Record<string, unknown>>): string {
+  const out = [COLUMNS.join(",")];
+  for (const row of rows) {
+    out.push(COLUMNS.map((c) => cell(row[c])).join(","));
+  }
+  return out.join("\n");
+}
+
+export function estimateBytes(rows: Array<Record<string, unknown>>): number {
+  let n = COLUMNS.join(",").length + 1;
+  for (const row of rows) {
+    for (const c of COLUMNS) {
+      n += String(row[c] ?? "").length + 1;
+    }
+  }
+  return n;
+}

diff --git a/src/routes/export.ts b/src/routes/export.ts
