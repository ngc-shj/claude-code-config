@@ -0,0 +1,118 @@
+import { prisma } from "../db";
+import { withElevatedRead } from "../db/elevated";
+import { toCsv } from "../lib/csv";
+import { putArtifact } from "../storage";
+import { logger } from "../logger";
+
+const CLAIM_LIMIT = 25;
+
+export interface ExportJobRow {
+  id: string;
+  tenantId: string;
+  requestedBy: string;
+  status: string;
+}
+
+/**
+ * Claims up to CLAIM_LIMIT pending jobs and runs them. Called from the worker
+ * loop every 30s.
+ */
+export async function runExportBatch(): Promise<number> {
+  let processed = 0;
+
+  await prisma.$transaction(async (tx) => {
+    const jobs = await withElevatedRead(tx, (t) =>
+      t.exportJob.findMany({
+        where: { status: "pending" },
+        orderBy: { requestedAt: "asc" },
+        take: CLAIM_LIMIT,
+      }),
+    );
+
+    for (const job of jobs) {
+      const rows = await tx.record.findMany({
+        where: { tenantId: job.tenantId },
+        orderBy: { createdAt: "asc" },
+      });
+
+      const csv = toCsv(rows);
+      const path = `exports/${job.tenantId}/${job.id}.csv`;
+      await putArtifact(path, csv);
+
+      await tx.exportJob.update({
+        where: { id: job.id },
+        data: {
+          status: "done",
+          rowCount: rows.length,
+          artifactPath: path,
+          finishedAt: new Date(),
+        },
+      });
+
+      await tx.exportAudit.create({
+        data: {
+          jobId: job.id,
+          tenantId: job.tenantId,
+          actorId: job.requestedBy,
+          rowCount: rows.length,
+        },
+      });
+
+      logger.info(
+        { jobId: job.id, tenantId: job.tenantId, rows: rows.length },
+        "export job complete",
+      );
+      processed += 1;
+    }
+  });
+
+  return processed;
+}
+
+/**
+ * Marks jobs that have been "running" for more than an hour as failed so the
+ * queue does not wedge behind a crashed worker.
+ */
+export async function reapStuckJobs(): Promise<number> {
+  const cutoff = new Date(Date.now() - 3_600_000);
+  const res = await prisma.exportJob.updateMany({
+    where: { status: "running", requestedAt: { lt: cutoff } },
+    data: { status: "failed", finishedAt: new Date() },
+  });
+  return res.count;
+}

