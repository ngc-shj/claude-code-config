@@ -0,0 +1,34 @@
+import type { Tx } from "./types";
+
+/**
+ * A handful of background readers legitimately need to see rows across every
+ * tenant — the export worker, the usage roll-up, the retention sweep. The
+ * `export_jobs_worker_read` policy honours `app.elevated_read`, so a caller
+ * announces itself before running the cross-tenant query.
+ *
+ * Only background workers may call this. Request-scoped code must not.
+ */
+export async function withElevatedRead<T>(
+  tx: Tx,
+  run: (tx: Tx) => Promise<T>,
+): Promise<T> {
+  await tx.$executeRawUnsafe(`SET LOCAL app.elevated_read = 'on'`);
+  return run(tx);
+}
+
+/**
+ * Pins the tenant for the remainder of the transaction so the ordinary
+ * isolation policies apply.
+ */
+export async function withTenant<T>(
+  tx: Tx,
+  tenantId: string,
+  run: (tx: Tx) => Promise<T>,
+): Promise<T> {
+  await tx.$executeRawUnsafe(
+    `SET LOCAL app.tenant_id = '${tenantId}'`,
+  );
+  return run(tx);
+}

diff --git a/src/jobs/export.ts b/src/jobs/export.ts
