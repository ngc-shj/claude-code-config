+import { prisma } from "../db";
+import { withTenant } from "../db/elevated";
+import { getSession } from "../auth";
+import { signPath } from "../lib/signing";
+import { json } from "../http";
+
+export async function POST(req: Request) {
+  const session = await getSession(req);
+  if (!session) return json({ error: "unauthenticated" }, { status: 401 });
+
+  const job = await prisma.$transaction((tx) =>
+    withTenant(tx, session.tenantId, (t) =>
+      t.exportJob.create({
+        data: { tenantId: session.tenantId, requestedBy: session.userId },
+      }),
+    ),
+  );
+
+  return json({ id: job.id, status: job.status }, { status: 202 });
+}
+
+export async function GET(req: Request) {
+  const session = await getSession(req);
+  if (!session) return json({ error: "unauthenticated" }, { status: 401 });
+
+  const url = new URL(req.url);
+  const id = url.searchParams.get("id");
+  if (!id) return json({ error: "id required" }, { status: 400 });
+
+  const job = await prisma.$transaction((tx) =>
+    withTenant(tx, session.tenantId, (t) =>
+      t.exportJob.findUnique({ where: { id } }),
+    ),
+  );
+
+  if (!job) return json({ error: "not_found" }, { status: 404 });
+  if (job.status !== "done") return json({ status: job.status });
+
+  return json({
+    status: job.status,
+    rowCount: job.rowCount,
+    download: signPath(job.artifactPath!, 15 * 60),
+  });
+}

diff --git a/src/lib/signing.ts b/src/lib/signing.ts
new file mode 100644
index 0000000..6f7a8b9
--- /dev/null
+++ b/src/lib/signing.ts
@@ -0,0 +1,29 @@
+import { createHmac } from "node:crypto";
+
+const SECRET = process.env.ARTIFACT_SIGNING_KEY ?? "dev-signing-key";
+
+export function signPath(path: string, ttlSeconds: number): string {
+  const expires = Math.floor(Date.now() / 1000) + ttlSeconds;
+  const mac = createHmac("sha256", SECRET)
+    .update(`${path}:${expires}`)
+    .digest("hex");
+  return `/artifacts/${path}?expires=${expires}&sig=${mac}`;
+}
+
+export function verifyPath(path: string, expires: string, sig: string): boolean {
+  if (Number(expires) * 1000 < Date.now()) return false;
+  const mac = createHmac("sha256", SECRET)
+    .update(`${path}:${expires}`)
+    .digest("hex");
+  return mac === sig;
+}

diff --git a/test/export.test.ts b/test/export.test.ts
new file mode 100644
index 0000000..7a8b9c0
--- /dev/null
+++ b/test/export.test.ts
@@ -0,0 +1,62 @@
+import { describe, it, expect, vi, beforeEach } from "vitest";
+import { toCsv, estimateBytes } from "../src/lib/csv";
+import { signPath, verifyPath } from "../src/lib/signing";
+
+describe("toCsv", () => {
+  it("emits a header row", () => {
+    expect(toCsv([]).split("\n")[0]).toBe("id,title,body,createdAt");
+  });
+
+  it("quotes fields containing a comma", () => {
+    const csv = toCsv([{ id: "1", title: "a,b", body: "x", createdAt: "t" }]);
+    expect(csv).toContain('"a,b"');
+  });
+
+  it("doubles embedded quotes", () => {
+    const csv = toCsv([{ id: "1", title: 'a"b', body: "x", createdAt: "t" }]);
+    expect(csv).toContain('"a""b"');
+  });
+
+  it("renders null as empty", () => {
+    const csv = toCsv([{ id: "1", title: null, body: "x", createdAt: "t" }]);
+    expect(csv).toContain("1,,x,t");
+  });
+});
+
+describe("estimateBytes", () => {
+  it("grows with row count", () => {
+    const one = estimateBytes([{ id: "1", title: "a", body: "b", createdAt: "c" }]);
+    const two = estimateBytes([
+      { id: "1", title: "a", body: "b", createdAt: "c" },
+      { id: "2", title: "a", body: "b", createdAt: "c" },
+    ]);
+    expect(two).toBeGreaterThan(one);
+  });
+});
+
+describe("signing", () => {
+  it("round-trips a signed path", () => {
+    const link = signPath("exports/t1/j1.csv", 600);
+    const u = new URL("http://x" + link);
+    expect(
+      verifyPath(
+        "exports/t1/j1.csv",
+        u.searchParams.get("expires")!,
+        u.searchParams.get("sig")!,
+      ),
+    ).toBe(true);
+  });
+
+  it("rejects an expired link", () => {
+    const past = String(Math.floor(Date.now() / 1000) - 10);
+    expect(verifyPath("exports/t1/j1.csv", past, "deadbeef")).toBe(false);
+  });
+});

