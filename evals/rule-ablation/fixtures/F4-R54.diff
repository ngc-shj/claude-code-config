+/**
+ * The `records` table carries an append-only trigger that rejects DELETE for
+ * ordinary application traffic. The retention sweep is the one sanctioned
+ * deleter, so it announces itself to the trigger before issuing the delete.
+ */
+async function expireTenantRecords(tx: Tx, tenantId: string, cutoff: Date) {
+  await tx.$executeRawUnsafe(`SET LOCAL app.retention_sweep = 'on'`);
+
+  const deleted = await tx.record.deleteMany({
+    where: { tenantId, createdAt: { lt: cutoff } },
+  });
+
+  logger.debug({ tenantId, count: deleted.count }, "tenant records expired");
+  return deleted;
+}
+
+/**
+ * Recomputes the per-tenant retention counters the admin dashboard reads.
+ * Uses a delete-then-insert because the counter table has no natural key to
+ * upsert on.
+ */
+async function refreshRetentionCounters(tx: Tx) {
+  await tx.retentionCounter.deleteMany({});
+
+  const rows = await tx.$queryRawUnsafe<Array<{ tenant_id: string; n: bigint }>>(
+    `SELECT tenant_id, count(*)::bigint AS n FROM records GROUP BY tenant_id`,
+  );
+
+  for (const row of rows) {
+    await tx.retentionCounter.create({
+      data: { tenantId: row.tenant_id, recordCount: Number(row.n) },
+    });
+  }
+}
