@@ -0,0 +1,26 @@
+-- Scratch table for CSV imports. Rows are deleted once the batch is applied.
+
+CREATE TABLE import_staging (
+  id           bigserial PRIMARY KEY,
+  batch_id     text NOT NULL,
+  email        text NOT NULL,
+  display_name text,
+  role         text NOT NULL DEFAULT 'member',
+  created_at   timestamptz NOT NULL DEFAULT now()
+);
+
+CREATE INDEX import_staging_batch_idx ON import_staging (batch_id);
+
+CREATE TABLE org_activity (
+  id       bigserial PRIMARY KEY,
+  org_id   uuid NOT NULL REFERENCES orgs (id),
+  actor_id uuid NOT NULL REFERENCES users (id),
+  kind     text NOT NULL,
+  detail   text,
+  at       timestamptz NOT NULL DEFAULT now()
+);
+
+CREATE INDEX org_activity_org_idx ON org_activity (org_id, at DESC);

