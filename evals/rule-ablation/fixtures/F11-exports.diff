+
+func serialize(buf *bytes.Buffer, format Format, cols []string, rows *sql.Rows) (int, error) {
+	values := make([]any, len(cols))
+	targets := make([]any, len(cols))
+	for i := range values {
+		targets[i] = &values[i]
+	}
+	out := csv.NewWriter(buf)
+	enc := json.NewEncoder(buf)
+	if format == FormatCSV {
+		if err := out.Write(cols); err != nil {
+			return 0, err
+		}
+	}
+
+	n := 0
+	for rows.Next() {
+		if err := rows.Scan(targets...); err != nil {
+			return n, err
+		}
+		var err error
+		if format == FormatCSV {
+			record := make([]string, len(cols))
+			for i := range cols {
+				record[i] = formatValue(values[i])
+			}
+			err = out.Write(record)
+		} else {
+			record := make(map[string]any, len(cols))
+			for i, col := range cols {
+				record[col] = values[i]
+			}
+			err = enc.Encode(record)
+		}
+		if err != nil {
+			return n, err
+		}
+		n++
+	}
+	out.Flush()
+	return n, out.Error()
+}
+
+func formatValue(v any) string {
+	switch t := v.(type) {
+	case nil:
+		return ""
+	case []byte:
+		return string(t)
+	case time.Time:
+		return t.UTC().Format(time.RFC3339)
+	default:
+		return fmt.Sprint(t)
+	}
+}
+
+func objectKey(s *Schedule, at time.Time) string {
+	name := fmt.Sprintf("%s-%s.%s", s.Dataset, at.Format("2006-01-02"), s.Format)
+	if prefix := strings.Trim(s.Destination.Prefix, "/"); prefix != "" {
+		return prefix + "/" + name
+	}
+	return name
+}
+
+func contentType(format Format) string {
+	if format == FormatCSV {
+		return "text/csv"
+	}
+	return "application/x-ndjson"
+}
