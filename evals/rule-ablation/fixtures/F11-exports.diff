+++ b/internal/api/exports.go
@@ -0,0 +1,83 @@
+package api
+
+import (
+	"encoding/json"
+	"net/http"
+	"strconv"
+	"time"
+
+	"github.com/acme/analytics/internal/auth"
+	"github.com/acme/analytics/internal/exports"
+)
+
+type exportHandler struct {
+	store *exports.Store
+}
+
+func (h *exportHandler) create(w http.ResponseWriter, r *http.Request) {
+	org := auth.OrgFromContext(r.Context())
+
+	var body struct {
+		Name        string              `json:"name"`
+		Dataset     string              `json:"dataset"`
+		Format      exports.Format      `json:"format"`
+		Cadence     string              `json:"cadence"`
+		HourOfDay   int                 `json:"hour_of_day"`
+		Timezone    string              `json:"timezone"`
+		Destination exports.Destination `json:"destination"`
+	}
+	if err := json.NewDecoder(r.Body).Decode(&body); err != nil {
+		writeError(w, http.StatusBadRequest, "request body is not valid JSON")
+		return
+	}
+	if body.Timezone == "" {
+		body.Timezone = "UTC"
+	}
+
+	schedule := &exports.Schedule{
+		OrgID:       org.ID,
+		Name:        body.Name,
+		Dataset:     body.Dataset,
+		Format:      body.Format,
+		Cadence:     body.Cadence,
+		HourOfDay:   body.HourOfDay,
+		Timezone:    body.Timezone,
+		Destination: body.Destination,
+		Enabled:     true,
+	}
+	if err := schedule.Validate(); err != nil {
+		writeError(w, http.StatusUnprocessableEntity, err.Error())
+		return
+	}
+	schedule.NextRunAt = exports.NextRun(schedule, time.Now().UTC())
+
+	if err := h.store.Create(r.Context(), schedule); err != nil {
+		writeError(w, http.StatusInternalServerError, "could not save the export schedule")
+		return
+	}
+	writeJSON(w, http.StatusCreated, schedule)
+}
+
+func (h *exportHandler) list(w http.ResponseWriter, r *http.Request) {
+	org := auth.OrgFromContext(r.Context())
+
+	schedules, err := h.store.ListByOrg(r.Context(), org.ID)
+	if err != nil {
+		writeError(w, http.StatusInternalServerError, "could not load export schedules")
+		return
+	}
+	writeJSON(w, http.StatusOK, schedules)
+}
+
+func (h *exportHandler) delete(w http.ResponseWriter, r *http.Request) {
+	id, err := strconv.ParseInt(r.PathValue("id"), 10, 64)
+	if err != nil {
+		writeError(w, http.StatusBadRequest, "id must be an integer")
+		return
+	}
+	if err := h.store.Delete(r.Context(), id); err != nil {
+		writeError(w, http.StatusInternalServerError, "could not delete the export schedule")
+		return
+	}
+	w.WriteHeader(http.StatusNoContent)
+}
